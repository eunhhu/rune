{
  "name": "spellwire-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:native": "cargo build -p spellwire-native --release",
    "typecheck": "bunx tsc -b packages/spellwire packages/create-spellwire --pretty false",
    "test:rust": "cargo test --workspace",
    "test:ts": "bun test packages/spellwire/test packages/create-spellwire/test",
    "check": "bun run typecheck && bun run test:ts && cargo test --workspace",
    "compile:example": "bun packages/spellwire/src/cli.ts compile examples/stateful.spellwire.ts",
    "bench": "cargo run -p spellwire-bench --release --",
    "pack:dry-run": "npm pack --dry-run --workspace spellwire && npm pack --dry-run --workspace create-spellwire"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.8.3"
  }
}
