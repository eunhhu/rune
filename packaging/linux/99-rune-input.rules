# Rune needs raw keyboard/mouse observation and a virtual uinput device.
# TAG+="uaccess" grants the active local seat user access. Review this rule
# before installing it: readable event devices expose all keyboard input.
SUBSYSTEM=="input", KERNEL=="event*", TAG+="uaccess"
SUBSYSTEM=="misc", KERNEL=="uinput", TAG+="uaccess", OPTIONS+="static_node=uinput"
